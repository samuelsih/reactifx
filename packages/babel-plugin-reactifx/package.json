{
  "name": "babel-plugin-reactifx",
  "version": "0.1.0",
  "description": "Babel plugin that inlines reactifx's If component into conditional expressions",
  "keywords": [
    "babel-plugin",
    "conditional",
    "jsx",
    "react",
    "reactifx"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run lint && pnpm run fmt:check && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/types": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0 || ^8.0.0"
  }
}
