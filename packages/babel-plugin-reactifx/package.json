{
  "name": "@samuelsih/babel-plugin-reactifx",
  "version": "0.2.0",
  "description": "Babel plugin that inlines reactifx's component into conditional expressions",
  "keywords": [
    "babel-plugin",
    "conditional",
    "jsx",
    "react",
    "reactifx"
  ],
  "license": "MIT",
  "author": {
    "name": "Samuel",
    "email": "samuel.istnd@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samuelsih/reactifx.git",
    "directory": "packages/babel-plugin-reactifx"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/types": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0 || ^8.0.0"
  }
}
